{
  "name": "sila-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "qa": "node scripts/qa-gates.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run qa && npm run test",
    "api:types": "openapi-typescript ../Sila-Backend/docs/api/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.2.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.0",
    "animejs": "^4.5.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "decimal.js": "^10.6.0",
    "gsap": "^3.14.2",
    "lightweight-charts": "^5.2.1",
    "motion": "^13.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.64.0",
    "react-router-dom": "^7.3.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
